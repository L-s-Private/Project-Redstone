{
  "name": "project-redstone-app",
  "version": "0.28.0",
  "private": true,
  "description": "TikTok LIVE のギフトを受け取り、マイクラのMODに妨害を送るアプリ",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "electron .",
    "app:mock": "electron . --mock",
    "dist": "electron-builder --win portable --publish never",
    "start": "node src/index.js",
    "mock": "node src/index.js --mock",
    "gui": "node src/gui.js",
    "gui:mock": "node src/gui.js --mock",
    "test": "node --test"
  },
  "dependencies": {
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "STATIC ARC",
  "build": {
    "appId": "com.projectredstone.app",
    "productName": "STATIC ARC",
    "files": [
      "src/**/*",
      "electron/**/*",
      "config.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mod/build/libs",
        "to": "mod",
        "filter": [
          "project-redstone-*.jar",
          "!*-sources.jar"
        ]
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "StaticArc-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": "dir",
      "executableName": "project-redstone"
    }
  }
}
